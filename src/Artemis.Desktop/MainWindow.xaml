<Window x:Class="Artemis.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Artemis · Harness" Width="1380" Height="900" MinWidth="1050" MinHeight="720"
 Background="#10151E" Foreground="#E8EDF5" FontFamily="Segoe UI" FontSize="14" Closing="Window_Closing">
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="Padding" Value="14,9"/><Setter Property="Margin" Value="0,0,8,0"/>
   <Setter Property="Background" Value="#DCE8F9"/><Setter Property="Foreground" Value="#111B2D"/>
   <Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/>
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="Background" Value="#131C29"/><Setter Property="Foreground" Value="#E8EDF5"/>
   <Setter Property="BorderBrush" Value="#38475C"/><Setter Property="Padding" Value="10"/><Setter Property="CaretBrush" Value="White"/>
  </Style>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Padding" Value="8"/><Setter Property="Foreground" Value="#10151E"/></Style>
 </Window.Resources>
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,22">
   <StackPanel><TextBlock Text="ARTEMIS" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="프로젝트와 대화하고, 확인한 변경을 적용하세요." Foreground="#9BAEC8" Margin="0,6,0,0"/></StackPanel>
   <Border HorizontalAlignment="Right" Background="#203147" CornerRadius="6" Padding="14,8" VerticalAlignment="Center"><TextBlock Text="MILESTONE 01  /  HARNESS" Foreground="#B9D8FF" FontSize="12"/></Border>
  </Grid>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="270"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="310"/></Grid.ColumnDefinitions>
   <Border Background="#1A2331" CornerRadius="10" Padding="18">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
     <TextBlock Text="프로젝트" FontSize="18" FontWeight="SemiBold"/>
     <TextBlock x:Name="RootLabel" Text="작업 폴더를 선택하세요." Foreground="#ADBED3" Margin="0,12,0,12"/>
     <Button x:Name="ProjectButton" Content="폴더 선택" Click="ChooseProject_Click" HorizontalAlignment="Left"/>
     <TextBlock Text="읽은 파일·검색 결과는 선택한 모델에 전달됩니다." Foreground="#B7C7DB" Margin="0,16,0,8"/>
     <TextBlock Text="목록 · 읽기 · 검색은 자동 실행&#10;생성 · 수정은 매번 변경 확인&#10;&#10;제외: .git, .env, 비밀 파일, 바이너리, 링크&#10;명령 실행 · 삭제 · 이동 미지원" Foreground="#8FA2BD" FontSize="12"/>
     <Separator Margin="0,22" Background="#38475C"/>
     <TextBlock Text="ChatGPT 연결" FontSize="18" FontWeight="SemiBold"/>
     <ComboBox x:Name="AccountPicker" SelectionChanged="AccountPicker_SelectionChanged" Margin="0,12,0,10"/>
     <Button x:Name="SignInButton" Content="Continue with ChatGPT" Click="SignIn_Click" Margin="0,0,0,10"/>
     <Button x:Name="SignOutButton" Content="연결 해제" Click="SignOut_Click" Margin="0,0,0,12"/>
     <Button x:Name="RefreshTokenButton" Content="연결 토큰 갱신" Click="RefreshToken_Click" Margin="0,0,0,12"/>
     <TextBlock x:Name="AuthLabel" Text="연결 안 됨" Foreground="#9BAEC8"/>
     <TextBlock Text="모델" FontWeight="SemiBold" Margin="0,22,0,8"/>
     <ComboBox x:Name="ModelPicker" SelectedIndex="0"><ComboBoxItem Content="gpt-6.1-sol"/><ComboBoxItem Content="gpt-6.1-terra"/></ComboBox>
     <TextBlock x:Name="CatalogLabel" Text="로그인 후 모델 접근 목록을 확인합니다." Foreground="#9BAEC8" Margin="0,10,0,12" FontSize="12"/>
     <Button x:Name="CatalogButton" Content="모델 목록 새로고침" Click="RefreshCatalog_Click" Margin="0,0,0,10"/>
     <Button Content="ChatGPT 사용량 보기 ↗" Click="Usage_Click" Margin="0"/>
    </StackPanel></ScrollViewer>
   </Border>
   <Border Grid.Column="2" Background="#1A2331" CornerRadius="10" Padding="18"><Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,14"><Button x:Name="NewConversationButton" DockPanel.Dock="Right" Content="새 대화" Click="NewConversation_Click" Margin="0" Padding="10,5"/><TextBlock Text="대화" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
    <TextBox Grid.Row="1" x:Name="Transcript" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="#1A2331" Padding="0"/>
    <TextBox Grid.Row="2" x:Name="Prompt" AcceptsReturn="True" TextWrapping="Wrap" Height="112" Margin="0,16,0,12" VerticalScrollBarVisibility="Auto" ToolTip="작업을 입력한 후 요청 전송 버튼으로 실행하세요."/>
    <DockPanel Grid.Row="3"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="StopButton" Content="중단" Click="Stop_Click" IsEnabled="False"/><Button x:Name="SendButton" Content="요청 전송 →" Click="Send_Click" Background="#98C6FF" Margin="0"/></StackPanel><TextBlock Text="대화는 이 창에서만 유지됩니다." Foreground="#8FA2BD" FontSize="12" VerticalAlignment="Center"/></DockPanel>
   </Grid></Border>
   <Border Grid.Column="4" Background="#1A2331" CornerRadius="10" Padding="18"><Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="도구 실행 내역" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
    <TextBox Grid.Row="1" x:Name="ToolLog" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"/>
    <TextBlock Grid.Row="2" Text="변경 확인" FontSize="18" FontWeight="SemiBold" Margin="0,20,0,12"/>
    <TextBox Grid.Row="3" x:Name="ChangePreview" IsReadOnly="True" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" Text="승인할 변경이 없습니다."/>
    <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,12,0,0"><Button x:Name="ApproveButton" Content="변경 허용" Click="Approve_Click" IsEnabled="False" Background="#98C6FF"/><Button x:Name="DenyButton" Content="거부" Click="Deny_Click" IsEnabled="False"/></StackPanel>
   </Grid></Border>
  </Grid>
  <TextBlock Grid.Row="2" x:Name="StatusLabel" Text="대기 · 프로젝트 선택과 ChatGPT 로그인이 필요합니다." Foreground="#ADBED3" Margin="0,16,0,0"/>
 </Grid>
</Window>
